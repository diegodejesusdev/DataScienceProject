# ============================================================
# CONSTRUNORTE - Variables de entorno
# Copiar este archivo a .env y completar los valores
# ============================================================

# MySQL — Credenciales para los contenedores
MYSQL_ROOT_PASSWORD=cambiar_root_password
MYSQL_DATABASE=construnorte
MYSQL_USER=construnorte_user
MYSQL_PASSWORD=cambiar_user_password

# Jupyter
JUPYTER_TOKEN=cambiar_token

# Conexión desde host nativo (Apache Hop, Tableau, scripts locales)
# Para conexión desde dentro de Docker (Jupyter), MYSQL_HOST=mysql
# Para conexión desde host nativo, MYSQL_HOST=localhost
MYSQL_HOST=localhost
MYSQL_PORT=3306
